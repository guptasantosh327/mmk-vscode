{
  "name": "mmk-vscode",
  "displayName": "mmk for VS Code",
  "description": "Run, roll back and review mongo-migrate-kit MongoDB migrations from the editor",
  "version": "0.0.1",
  "publisher": "guptasantosh327",
  "license": "MIT",
  "author": "Santosh Gupta",
  "repository": {
    "type": "git",
    "url": "https://github.com/guptasantosh327/mmk-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mongodb",
    "migrations",
    "mongo-migrate-kit",
    "mmk"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "mmk runs the project's own mongo-migrate-kit from node_modules, which needs the files on disk."
    }
  },
  "activationEvents": [
    "workspaceContains:**/mmk.config.{js,ts,json}",
    "workspaceContains:**/package.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mmk",
          "title": "mmk",
          "icon": "media/mmk.svg"
        }
      ]
    },
    "views": {
      "mmk": [
        {
          "id": "mmk.migrations",
          "name": "Migrations",
          "icon": "media/mmk.svg",
          "contextualTitle": "mmk"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mmk.migrations",
        "when": "mmk.discovered && !mmk.hasProject",
        "contents": "No mmk project in this workspace.\nmmk for VS Code looks for an mmk.config.js, .ts or .json, or a package.json that depends on mongo-migrate-kit.\n[Read the getting started guide](https://mongo-migrate-kit.vercel.app/guide/getting-started)\n[Refresh](command:mmk.refresh)"
      },
      {
        "view": "mmk.migrations",
        "when": "mmk.problem == 'mmk-missing'",
        "contents": "mongo-migrate-kit isn't installed in this project.\nInstall it in the project (npm install mongo-migrate-kit mongodb), then refresh.\n[Refresh](command:mmk.refresh)\n[Show details](command:mmk.showOutput)"
      },
      {
        "view": "mmk.migrations",
        "when": "mmk.problem == 'too-old'",
        "contents": "Update mongo-migrate-kit to 1.5.0 or later.\nThis project has an older version, and mmk for VS Code only reads the output of 1.5.0 or later. Run npm install --save-dev mongo-migrate-kit@latest, then refresh.\n[Refresh](command:mmk.refresh)\n[Show details](command:mmk.showOutput)"
      },
      {
        "view": "mmk.migrations",
        "when": "mmk.problem == 'node-missing'",
        "contents": "Node.js wasn't found, and mmk needs it to run.\nInstall Node.js, or point the mmk.nodePath setting at the node executable.\n[Set the Node.js path](command:workbench.action.openSettings?%5B%22mmk.nodePath%22%5D)\n[Refresh](command:mmk.refresh)"
      },
      {
        "view": "mmk.migrations",
        "when": "mmk.problem == 'failed'",
        "contents": "mmk couldn't start in this project.\nThe mmk output has its message.\n[Show details](command:mmk.showOutput)\n[Refresh](command:mmk.refresh)"
      }
    ],
    "commands": [
      {
        "command": "mmk.refresh",
        "title": "Refresh",
        "category": "mmk",
        "icon": "$(refresh)"
      },
      {
        "command": "mmk.createMigration",
        "title": "Create migration",
        "category": "mmk",
        "icon": "$(add)"
      },
      {
        "command": "mmk.up",
        "title": "Run up on local",
        "category": "mmk",
        "icon": "$(play)"
      },
      {
        "command": "mmk.upAll",
        "title": "Apply all pending on local",
        "category": "mmk",
        "icon": "$(run-all)"
      },
      {
        "command": "mmk.down",
        "title": "Run down on local",
        "category": "mmk",
        "icon": "$(discard)"
      },
      {
        "command": "mmk.redo",
        "title": "Redo on local",
        "category": "mmk",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mmk.dryRun",
        "title": "Dry run",
        "category": "mmk",
        "icon": "$(eye)"
      },
      {
        "command": "mmk.unlock",
        "title": "Release the migration lock…",
        "category": "mmk",
        "icon": "$(unlock)"
      },
      {
        "command": "mmk.copyCliCommand",
        "title": "Copy CLI command",
        "category": "mmk",
        "icon": "$(copy)"
      },
      {
        "command": "mmk.selectEnvironment",
        "title": "Select environment",
        "category": "mmk"
      },
      {
        "command": "mmk.showOutput",
        "title": "Show output",
        "category": "mmk",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mmk.createMigration",
          "when": "view == mmk.migrations && mmk.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "mmk.refresh",
          "when": "view == mmk.migrations",
          "group": "navigation@2"
        },
        {
          "command": "mmk.copyCliCommand",
          "when": "view == mmk.migrations && mmk.hasProject",
          "group": "1_actions@1"
        },
        {
          "command": "mmk.unlock",
          "when": "view == mmk.migrations && mmk.hasProject",
          "group": "1_actions@2"
        },
        {
          "command": "mmk.showOutput",
          "when": "view == mmk.migrations",
          "group": "2_output@1"
        }
      ],
      "view/item/context": [
        {
          "command": "mmk.upAll",
          "when": "view == mmk.migrations && viewItem == mmk.group.pending",
          "group": "inline@1"
        },
        {
          "command": "mmk.dryRun",
          "when": "view == mmk.migrations && viewItem == mmk.group.pending",
          "group": "inline@2"
        },
        {
          "command": "mmk.up",
          "when": "view == mmk.migrations && viewItem == mmk.migration.pending",
          "group": "inline@1"
        },
        {
          "command": "mmk.up",
          "when": "view == mmk.migrations && viewItem == mmk.migration.pending",
          "group": "1_run@1"
        },
        {
          "command": "mmk.dryRun",
          "when": "view == mmk.migrations && viewItem == mmk.migration.pending",
          "group": "1_run@2"
        },
        {
          "command": "mmk.down",
          "when": "view == mmk.migrations && viewItem == mmk.migration.applied",
          "group": "inline@1"
        },
        {
          "command": "mmk.down",
          "when": "view == mmk.migrations && viewItem == mmk.migration.applied",
          "group": "1_run@1"
        },
        {
          "command": "mmk.redo",
          "when": "view == mmk.migrations && viewItem == mmk.migration.applied",
          "group": "1_run@2"
        },
        {
          "command": "mmk.copyCliCommand",
          "when": "view == mmk.migrations && viewItem =~ /^mmk\\.migration\\.(pending|applied)$/",
          "group": "2_copy@1"
        }
      ],
      "commandPalette": [
        {
          "command": "mmk.createMigration",
          "when": "mmk.hasProject"
        },
        {
          "command": "mmk.up",
          "when": "mmk.hasProject"
        },
        {
          "command": "mmk.upAll",
          "when": "mmk.hasProject"
        },
        {
          "command": "mmk.down",
          "when": "mmk.hasProject"
        },
        {
          "command": "mmk.redo",
          "when": "mmk.hasProject"
        },
        {
          "command": "mmk.dryRun",
          "when": "mmk.hasProject"
        },
        {
          "command": "mmk.unlock",
          "when": "mmk.hasProject"
        },
        {
          "command": "mmk.copyCliCommand",
          "when": "mmk.hasProject"
        },
        {
          "command": "mmk.selectEnvironment",
          "when": "mmk.hasProject"
        }
      ]
    },
    "configuration": {
      "title": "mmk",
      "properties": {
        "mmk.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Node.js executable that runs `mmk`. Leave empty to use `node` from `PATH`, the same one your terminal uses."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "bundle": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "pretest:integration": "node esbuild.js && tsc -p tsconfig.integration.json",
    "test:integration": "vscode-test && node test/integration/run-installed.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mongo-migrate-kit": "1.5.0",
    "mongodb": "^6.12.0",
    "mongodb-memory-server": "^10.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
